GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=["gemini-3.8-flash", "gemini-3.1-flash-lite"]
SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here
# Optional tier-2 AI fallback when every Gemini model is down: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODELS=["openai/gpt-oss-120b", "qwen/qwen3.8-27b", "openai/gpt-oss-20b"]
# Optional tier-3 fallback for localhost demos: a model pulled into a local Ollama, e.g. qwen2.5:7b
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Security (defaults shown). In production set ENABLE_DOCS=false and TRUST_PROXY_HEADERS=true.
# CORS_ORIGINS=https://fraud-detector-hackathon.vercel.app
# ENABLE_DOCS=true
# TRUST_PROXY_HEADERS=false
# RATE_LIMIT_PER_CLIENT=12
# RATE_LIMIT_GLOBAL=40
